{
  "name": "mao",
  "productName": "MAO",
  "version": "1.2.1",
  "description": "MAO - phần mềm gọi món bằng mã QR cho quán ăn",
  "author": "Missing",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "mau": "node server.js --mau",
    "test": "node test.js",
    "app": "electron .",
    "bo-cai": "electron-builder --win nsis --x64",
    "bo-cai-mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "qrcode-generator": "^1.4.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": ">=37.0.0",
    "electron-builder": ">=26.0.0"
  },
  "build": {
    "appId": "vn.mao.app",
    "productName": "MAO",
    "copyright": "© 2026 Missing. Xem file LICENSE.",
    "files": [
      "server.js",
      "khuyenmai.js",
      "du-lieu-mau.js",
      "public/**",
      "desktop/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "HUONG-DAN.pdf",
        "to": "HUONG-DAN.pdf"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MAO",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MAO.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": "-",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "MAO nhận đơn từ điện thoại của khách và nhân viên trong WiFi quán."
      }
    },
    "dmg": {
      "artifactName": "MAO-Mac-${arch}.dmg"
    }
  }
}
